# SafeCDS Environment Configuration

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# HermiT / Java Configuration
JAVA_HEAP_MAX=2000M

# Hybrid Retrieval Settings
